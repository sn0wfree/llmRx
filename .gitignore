# Config (local overrides)
config.local.yml
*.env

# Docker master-key material (P0). The shipped docker-compose
# mounts ./secrets/llmrx_key_master for production deployments.
/secrets/

# Local runtime data (bind-mounted into the gateway container).
# Holds SQLite DB, master key, thompson state, and per-date logs.
# Excluded wholesale — the bind mount recreates these on every run.
data/
# Performance-test artifacts (used by scripts/loadtest)
data.bak*/
# Allow a placeholder so the directory survives a fresh clone.
!data/.gitkeep

# Jupyter checkpoints
.ipynb_checkpoints/
